{
  "name": "neuro-chess",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "api:generate": "openapi-typescript openapi/schema.json -o src/generated/api.d.ts",
    "api:check": "openapi-typescript openapi/schema.json -o src/generated/api.d.ts --check",
    "profile:compiler": "node scripts/profile-compiler.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "serve": "node scripts/serve-production.mjs",
    "test": "node --test src/*.test.js",
    "test:browser": "npm run build && playwright test",
    "benchmark:pdf": "node scripts/benchmark-pdf.mjs",
    "benchmark:pdf:books": "playwright test e2e/pdf-benchmark.spec.js --project desktop"
  },
  "dependencies": {
    "@asgardeo/auth-react": "^5.6.2",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.20.0",
    "chess.js": "^1.4.0",
    "react": "^19.2.8",
    "react-chessboard": "^4.7.3",
    "react-dom": "^19.2.8",
    "react-pdf": "^11.0.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "web-vitals": "^6.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0"
  }
}
