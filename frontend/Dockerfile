FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_API_URL=http://localhost:8000
ARG VITE_ASGARDEO_CLIENT_ID
ARG VITE_ASGARDEO_BASE_URL
ARG VITE_ASGARDEO_SIGN_IN_REDIRECT_URL
ARG VITE_ASGARDEO_SIGN_OUT_REDIRECT_URL
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_ASGARDEO_CLIENT_ID=$VITE_ASGARDEO_CLIENT_ID
ENV VITE_ASGARDEO_BASE_URL=$VITE_ASGARDEO_BASE_URL
ENV VITE_ASGARDEO_SIGN_IN_REDIRECT_URL=$VITE_ASGARDEO_SIGN_IN_REDIRECT_URL
ENV VITE_ASGARDEO_SIGN_OUT_REDIRECT_URL=$VITE_ASGARDEO_SIGN_OUT_REDIRECT_URL
RUN npm run build

FROM nginx:stable-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
