# Docker Compose settings. Use URL-safe passwords (letters and numbers only)
# for POSTGRES_PASSWORD and RABBITMQ_PASSWORD, or percent encode reserved URL characters.
POSTGRES_USER=chess
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=chessrag
RABBITMQ_PASSWORD=replace-with-another-long-random-value
REDIS_PASSWORD=replace-with-a-third-long-random-value

# Asgardeo API resource settings. Configure the app to issue JWT access tokens
# with this audience and use the matching issuer and JWKS URLs from your tenant.
ASGARDEO_ISSUER=https://api.asgardeo.io/t/yasiru2002projects/oauth2/token
ASGARDEO_JWKS_URL=https://api.asgardeo.io/t/yasiru2002projects/oauth2/jwks
ASGARDEO_AUDIENCE=oRNCmE0Hn5GH7tPZ0VOSY8p1ZLoa

# Optional service and deployment settings
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash
CORS_ORIGINS=http://localhost:5173

# Ingestion is denied unless a validated token contains this scope, or the optional role.
INGEST_REQUIRED_SCOPE=chess:ingest
INGEST_REQUIRED_ROLE=
INGEST_ROLE_CLAIM=roles
DB_POOL_MAX=8
VECTOR_DB_POOL_MAX=4
API_MEMORY_LIMIT=2g
API_CPUS=2
INGESTION_MEMORY_LIMIT=2g
INGESTION_CPUS=1
RATE_REPORTS_PER_MINUTE=6
RATE_OCR_PER_MINUTE=12
RATE_MOVES_PER_MINUTE=60
RATE_INGESTION_PER_MINUTE=5
BACKUP_INTERVAL_SECONDS=86400

# Optional local tracing: start the observability Compose profile first.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLE_RATIO=0.25
# Keep exact search until benchmarks justify an HNSW index.
VECTOR_SEARCH_MODE=exact
